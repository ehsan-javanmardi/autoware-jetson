<launch>
  <arg name="launch_driver" default="true"/>

  <!-- Host address the sensors send their UDP data to. This becomes the driver's udp_dest,
       so it has to be this machine's address ON THE SENSOR LAN (enp3s0), not the address it
       reaches the internet by. Pointing it anywhere else gives a driver that connects and
       configures the sensor normally and then never receives a packet. -->
  <arg name="host_ip" default="192.168.1.101"/>

  <!-- Which set of lidars is fitted. Each profile selects the drivers to start and a matching
       concatenate configuration from config/lidar_profiles/, whose input_topics and timestamp
       arrays have to agree with the drivers that actually publish. See docs/SENSORS.md. -->
  <arg name="lidar_profile" default="livox"
       description="fitted lidar set: livox | os1_128 | os2_32 | velodyne"/>

  <!-- The Livox HAP is on the same wire as the Ousters. Its address is configured in
       livox_ros_driver2/config/HAP_config.json, which the SDK reads directly, so it is
       not an argument here. See docs/LIVOX_HAP.md. -->
  <let name="use_livox"
       value="$(eval &quot;'true' if '$(var lidar_profile)' == 'livox' else 'false'&quot;)"/>

  <arg name="os1_128_ip" default="192.168.1.126" description="Ouster OS-1-128 address"/>
  <arg name="os2_32_ip" default="192.168.1.120" description="Ouster OS-2-32 address"/>

  <let name="use_ouster"
       value="$(eval &quot;'true' if '$(var lidar_profile)'.startswith('os') else 'false'&quot;)"/>
  <let name="use_velodyne"
       value="$(eval &quot;'true' if 'velodyne' in '$(var lidar_profile)' else 'false'&quot;)"/>
  <!-- The concatenate node throws "Only one topic given. Need at least two topics to continue."
       and refuses to load, so single lidar profiles get a passthrough instead. -->
  <let name="concat_enabled"
       value="$(eval &quot;'false' if '$(var lidar_profile)' in ('os1_128', 'os2_32', 'livox') else 'true'&quot;)"/>

  <!-- The passthrough below has to name the one cloud that actually arrives, and the frame
       it arrives in. Both differ per single-lidar profile. -->
  <let name="single_lidar_topic"
       value="$(eval &quot;'/sensing/lidar/top/livox/points' if '$(var lidar_profile)' == 'livox' else '/sensing/lidar/top/ouster/points'&quot;)"/>
  <let name="single_lidar_frame"
       value="$(eval &quot;'livox_frame' if '$(var lidar_profile)' == 'livox' else 'os_lidar_top'&quot;)"/>
  <let name="ouster_ip"
       value="$(eval &quot;'$(var os2_32_ip)' if '$(var lidar_profile)' == 'os2_32' else '$(var os1_128_ip)'&quot;)"/>

  <arg name="use_concat_filter" default="true"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="vehicle_mirror_param_file"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <group>
    <push-ros-namespace namespace="lidar"/>

    <!-- Livox HAP -->
    <group if="$(var use_livox)">
      <include file="$(find-pkg-share pixkit_sensor_kit_launch)/launch/livox_hap.launch.xml">
        <arg name="launch_driver" value="$(var launch_driver)"/>
      </include>
    </group>

    <!-- Ouster OS-1 (top) -->
    <group if="$(var use_ouster)">
      <include file="$(find-pkg-share pixkit_sensor_kit_launch)/launch/os_sensor_top.launch.xml">
        <arg name="sensor_hostname_top" value="$(var ouster_ip)"/>
        <arg name="udp_dest" value="$(var host_ip)"/>
        <arg name="viz" value="false"/>
      </include>
    </group>

    <!-- Original Velodyne VLP16 configuration, disabled by default (no VLP16 is connected) -->
    <group if="$(var use_velodyne)">


      <group>
        <push-ros-namespace namespace="top"/>
        <include file="$(find-pkg-share common_sensor_launch)/launch/velodyne_VLP16.launch.xml">
          <arg name="max_range" value="250.0"/>
          <arg name="sensor_frame" value="velodyne_top"/>
          <arg name="sensor_ip" value="192.168.1.201"/>
          <arg name="host_ip" value="$(var host_ip)"/>
          <arg name="data_port" value="2368"/>
          <arg name="scan_phase" value="300.0"/>
          <arg name="launch_driver" value="$(var launch_driver)"/>
          <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
          <arg name="container_name" value="pointcloud_container"/>
        </include>
      </group>

      <group>
        <push-ros-namespace namespace="left"/>
        <include file="$(find-pkg-share common_sensor_launch)/launch/velodyne_VLP16.launch.xml">
          <arg name="max_range" value="5.0"/>
          <arg name="sensor_frame" value="velodyne_left"/>
          <arg name="sensor_ip" value="192.168.1.202"/>
          <arg name="host_ip" value="$(var host_ip)"/>
          <arg name="data_port" value="2369"/>
          <arg name="scan_phase" value="180.0"/>
          <arg name="cloud_min_angle" value="300"/>
          <arg name="cloud_max_angle" value="60"/>
          <arg name="launch_driver" value="$(var launch_driver)"/>
          <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
          <arg name="container_name" value="pointcloud_container"/>
        </include>
      </group>

      <group>
        <push-ros-namespace namespace="right"/>
        <include file="$(find-pkg-share common_sensor_launch)/launch/velodyne_VLP16.launch.xml">
          <arg name="max_range" value="5.0"/>
          <arg name="sensor_frame" value="velodyne_right"/>
          <arg name="sensor_ip" value="192.168.1.203"/>
          <arg name="host_ip" value="$(var host_ip)"/>
          <arg name="data_port" value="2370"/>
          <arg name="scan_phase" value="180.0"/>
          <arg name="cloud_min_angle" value="300"/>
          <arg name="cloud_max_angle" value="60"/>
          <arg name="launch_driver" value="$(var launch_driver)"/>
          <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
          <arg name="container_name" value="pointcloud_container"/>
        </include>
      </group>

      <group>
        <push-ros-namespace namespace="rear"/>
        <include file="$(find-pkg-share common_sensor_launch)/launch/velodyne_VLP16.launch.xml">
          <arg name="max_range" value="1.5"/>
          <arg name="sensor_frame" value="velodyne_rear"/>
          <arg name="sensor_ip" value="192.168.1.204"/>
          <arg name="host_ip" value="$(var host_ip)"/>
          <arg name="data_port" value="2371"/>
          <arg name="scan_phase" value="180.0"/>
          <arg name="cloud_min_angle" value="300"/>
          <arg name="cloud_max_angle" value="60"/>
          <arg name="launch_driver" value="$(var launch_driver)"/>
          <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
          <arg name="container_name" value="pointcloud_container"/>
        </include>
      </group>
    </group>

    <!-- Single lidar: nothing to concatenate. Autoware still expects the cloud on
         /sensing/lidar/concatenated/pointcloud and in base_link, which is what the concatenate
         node would have produced, so pass it through a crop box whose only job is the
         transform. A plain topic relay would leave the cloud in the sensor frame, and ground
         segmentation reads heights as if they were relative to the vehicle. -->
    <group unless="$(var concat_enabled)">
      <load_composable_node target="/$(var pointcloud_container_name)">
        <composable_node pkg="autoware_pointcloud_preprocessor"
                         plugin="autoware::pointcloud_preprocessor::CropBoxFilterComponent"
                         name="single_lidar_passthrough">
          <remap from="input" to="$(var single_lidar_topic)"/>
          <remap from="output" to="/sensing/lidar/concatenated/pointcloud"/>
          <!-- Both frames are required: the component refuses to construct with an empty
               input_frame, and without output_frame the cloud stays in the sensor frame. -->
          <param name="input_frame" value="$(var single_lidar_frame)"/>
          <param name="output_frame" value="base_link"/>
          <param name="min_x" value="-1000.0"/>
          <param name="max_x" value="1000.0"/>
          <param name="min_y" value="-1000.0"/>
          <param name="max_y" value="1000.0"/>
          <param name="min_z" value="-1000.0"/>
          <param name="max_z" value="1000.0"/>
          <param name="negative" value="false"/>
          <param name="processing_time_threshold_sec" value="0.01"/>
        </composable_node>
      </load_composable_node>
    </group>

    <include file="$(find-pkg-share pixkit_sensor_kit_launch)/launch/pointcloud_preprocessor.launch.py">
      <arg name="base_frame" value="base_link"/>
      <arg name="use_intra_process" value="true"/>
      <arg name="use_multithread" value="true"/>
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
      <!-- The profile decides this, not the caller: it has to match the number of input
           topics in the profile's parameter file. -->
      <arg name="use_concat_filter" value="$(var concat_enabled)"/>
      <!-- One concatenate configuration per lidar profile: the node needs one entry in
           input_topics, lidar_timestamp_offsets and lidar_timestamp_noise_window for every
           cloud that will actually arrive, and mismatched array lengths are a startup error. -->
      <arg name="concatenate_and_time_sync_node_param_path"
           value="$(find-pkg-share pixkit_sensor_kit_launch)/config/lidar_profiles/$(var lidar_profile).param.yaml"/>
    </include>
  </group>
</launch>
