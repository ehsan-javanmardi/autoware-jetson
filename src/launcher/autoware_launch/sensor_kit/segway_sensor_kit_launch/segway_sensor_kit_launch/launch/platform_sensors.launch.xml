<?xml version="1.0"?>
<!--
  Sensor DRIVERS only, in the namespace Autoware expects.

  segway.sh starts these and keeps them for the life of the platform; Autoware then runs
  with launch_sensing_driver:=false and supplies the processing chain around them.

  The namespace matters and is easy to get wrong. gnss.launch.xml pushes a relative
  "gnss", so launching it at the root puts the receiver on /gnss/fix while Autoware's
  own gnss_poser waits on /sensing/gnss/fix. The result is two gnss_poser nodes, one of
  them starved, and a localization stack with no GNSS.

  This file therefore pushes "sensing" and starts only the drivers. gnss_poser,
  imu_corrector and the pointcloud preprocessing all belong to Autoware's sensing chain,
  and starting them here would duplicate them.
-->
<launch>
  <arg name="launch_lidar" default="true"/>
  <arg name="launch_gnss" default="true"/>

  <group>
    <push-ros-namespace namespace="sensing"/>

    <!-- The Livox launch remaps to absolute /sensing/... topics, which a namespace
         push does not affect, so it is correct either way. It is inside the group so
         that everything the platform starts is described in one place. -->
    <group if="$(var launch_lidar)">
      <include file="$(find-pkg-share segway_sensor_kit_launch)/launch/livox_hap.launch.xml"/>
    </group>

    <group if="$(var launch_gnss)">
      <push-ros-namespace namespace="gnss"/>

      <!-- gnss_rtk.launch.py, not ublox_dgnss's own rover launch. Two things have to
           hold together or RTK cannot work, and neither can be set from outside:
           the NavSatFix publisher must be RELIABLE, and the NTRIP client must be the
           one that uplinks an NMEA GGA. See the file for why. -->
      <include file="$(find-pkg-share segway_sensor_kit_launch)/launch/gnss_rtk.launch.py">
        <arg name="device_family" value="F9R"/>
      </include>
    </group>
  </group>
</launch>
