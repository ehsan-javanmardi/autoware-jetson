<?xml version="1.0"?>
<!--
  Foxglove bridge for the Jetson platform.

    ros2 launch ./foxglove/foxglove_bridge.launch.xml
    ros2 launch ./foxglove/foxglove_bridge.launch.xml topics_config:=/path/to/topics.yaml

  Then connect from the Foxglove iPad app or app.foxglove.dev to
  ws://<jetson-ip>:8765 and load a layout from foxglove/layouts/.

  The allow list is generated from foxglove/topics.yaml by build_whitelist.py so
  that one file is the single source of truth, shared with the web UI. Passing
  topic_whitelist directly still works and overrides it.
-->
<launch>
  <arg name="port" default="8765"/>
  <arg name="address" default="0.0.0.0"/>
  <arg name="topic_whitelist" default=""
       description="regex list; empty means derive it from topics_config"/>
  <arg name="topics_config" default="$(find-pkg-share segway_web_ui)/../../../../foxglove/topics.yaml"
       description="group definitions shared with the web UI"/>

  <!-- send_buffer_limit: a slow tablet on wifi must not build an unbounded queue on
       the Jetson. The bridge drops for that client instead. -->
  <arg name="send_buffer_limit" default="10000000"/>
  <arg name="num_threads" default="0"/>
  <arg name="max_qos_depth" default="10"/>

  <include file="$(find-pkg-share foxglove_bridge)/launch/foxglove_bridge_launch.xml">
    <arg name="port" value="$(var port)"/>
    <arg name="address" value="$(var address)"/>
    <arg name="send_buffer_limit" value="$(var send_buffer_limit)"/>
    <arg name="num_threads" value="$(var num_threads)"/>
    <arg name="max_qos_depth" value="$(var max_qos_depth)"/>
    <arg name="topic_whitelist" value="$(var topic_whitelist)"/>
  </include>
</launch>
